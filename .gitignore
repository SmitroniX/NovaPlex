*.mp4
*.mkv
*.avi
*.mov
*.webm
*.ts
*.m4v

# Environment & Secrets
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System
.DS_Store
Thumbs.db
