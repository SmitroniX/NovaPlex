# NovaPlex Configuration

# Server Port (Default: 5050)
PORT=5050

# Gofile Cloud Storage (Optional)
# Enter your Gofile API token from https://gofile.io/myProfile
GOFILE_TOKEN=
GOFILE_ROOT_FOLDER=

# TMDB API Key for metadata fetching (Optional)
TMDB_API_KEY=

# Custom Database Path (Optional)
# NOVAPLEX_DB_PATH=/path/to/custom/novaplex.db
